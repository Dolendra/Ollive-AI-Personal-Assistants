# Groq — frontier assistant + evaluation judge (free tier)
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Judge model (defaults to GROQ_MODEL if unset)
JUDGE_MODEL=llama-3.3-70b-versatile

# OSS — deploy via HF Space only (see docs/HF_SPACE_ONLY.md). Local dev optional:
OSS_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
USE_HF_INFERENCE_API=false
HF_SPACE_REPO=Dolendra/ollive-oss-assistant
HF_SPACE_FRONTIER_REPO=Dolendra/ollive-frontier-assistant
# Write token required to upload Spaces: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...
